@{
    ViewData["Title"] = "Home Page";
}

<div class="welcome-page">
    <h2 class="welcome-title">
        Welcome op het Aankoop platform van <em>Prularia</em> 
    </h2>
</div>
    

<div>
    <p><span class="d-flex justify-content-center text-bg-success">@TempData["SuccessUpdatePasswordMessage"]</span></p>
    <form asp-controller="Security" asp-action="Afmelden" method="post">
        <div class="d-flex justify-content-center">
            <button type="submit" class="btn btn-danger btn-lg px-5">
                Afmelden
            </button>
        </div>
    </form>
</div>

