@model Web.Models.ViewModels.ArtikelDetailsViewModel

@if (Model is not null)
{
    <h2>Artikeldetails</h2>
    <p>EAN: @Model.Ean</p>
    <p>Naam: @Model.Naam</p>
    <p>Beschrijving: @Model.Beschrijving</p>
    <p>Prijs: @Model.Prijs</p>
    <p>Gewicht in gram: @Model.GewichtInGram</p>
    <p>Bestelpeil: @Model.Bestelpeil</p>
    <p>Voorraad: @Model.Voorraad</p>
    <p>Minimumvoorraad: @Model.MinimumVoorraad</p>
    <p>Maximumvoorraad: @Model.MaximumVoorraad</p>
    <p>Levertijd: @Model.Levertijd</p>
    <p>Aantal besteld leverancier: @Model.AantalBesteldLeverancier</p>
    <p>Maximum aantel in magazijnplaats: @Model.MaxAantalInMagazijnPlaats</p>
    <p>Leverancier: @Model.Leverancier.Naam</p>

    <h4>Categorieën</h4>
    @foreach (var c in Model.CategorieStructuren)
    {
        <p><strong>@c.Hoofdcategorie?.Naam</strong> &rarr; @c.Subcategorie</p>
    }
    
    <a asp-action="ArtikelWijzigen" asp-route-id="@Model.ArtikelId" class="btn btn-tertiary overview-details-button">Wijzigen</a>

}
else
{
    <p>Artikel niet gevonden.</p>
}