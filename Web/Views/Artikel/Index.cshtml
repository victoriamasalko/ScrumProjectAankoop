@model ArtikelIndexOverviewViewModel;
@{
    ViewData["Title"] = "Overzicht artikelen";
}
<section class="overview-page">
    <header class="overview-header">
        <h1 class="overview-title">
            Artikelen op de <em>plank</em>
        </h1>


        <button id="openAddLeverancierBtn" class="btn btn-primary overview-create-button" type="button">
            <span aria-hidden="true">+</span>
            NIEUW ARTIKEL
        </button>
        @* <a asp-controller="Artikel" asp-action="ArtikelToevoegen" class="btn btn-primary overview-create-button">+ NIEUW ARTIKEL</a> *@

    </header>

    <div class="overview-toolbar row gx-3 align-items-end">
        <div class="col-8 col-md-3">
            <label class="visually-hidden" for="overview-category">Categorie</label>
            <select class="form-select overview-control" id="overview-category">

                <option value="" selected>Alle categorieën</option>
                @foreach (var categorie in Model.Categorieën)
                {
                    <option value="@categorie.CategorieId">@categorie.Naam</option>

                }
            </select>
        </div>
        <div class="col-6 col-md-2">
            <label class="visually-hidden" for="overview-status">Status</label>
            <select class="form-select overview-control" id="overview-article-status">
                <option value="" selected>Alle artikel Statussen</option>
                <option value="true">Actief</option>
                <option value="false">InActief</option>


            </select>
        </div>
        <div class="col-8 col-md-3">
            <label class="visually-hidden" for="overview-status">Status</label>
            <select class="form-select overview-control" id="overview-stock-status">
                <option selected>Alle Voorraad Statussen</option>
            </select>
        </div>
        <div class="col-12 col-md-4">
            <label class="visually-hidden" for="overview-search">Zoeken</label>
            <input class="form-control overview-control" id="overview-search" type="search" placeholder="Zoeken op naam, beschrijving of EAN..." />
        </div>
    </div>

	
    <div class="table-responsive overview-table-wrapper">
        <table class="table overview-table align-middle mb-0">
            <thead>
                <tr>
                    <th class="p-2">Naam</th>
                    <th class="p-2">Beschrijving</th>
                    <th class="p-2">Categorieën</th>
                    <th class="p-2">EAN</th>
                    <th class="p-2">Prijs</th>
                    <th class="p-2">Voorraad</th>
                    <th class="p-2">Status</th>

                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var artikel in Model.Artikels)
                {
                    @await Component.InvokeAsync("ArtikelRow", artikel)

                }
            </tbody>
        </table>
    </div>

    <div id="modalContainer"></div>
</section>

@* Toon een melding of zoiets wanneer er nog geen artikelen zijn. *@
@if (Model.Artikels.Count() == 0)
{
    <div>Er zijn nog geen artikelen.</div>
}

<script>
    const searchbar = document.getElementById("overview-search");
    const categorieDropdown = document.getElementById("overview-category");
    const artikelStatusDropdown = document.getElementById("overview-article-status");

    function filterRows() {

        const searchValue = searchbar.value.trim().toLowerCase();
        const selectedCategorieId = categorieDropdown.value;
        const selectedArtikelStatus = artikelStatusDropdown.value;

        document.querySelectorAll(".overview-table tbody tr").forEach(row => {

            const artikelNaam = row.querySelector(".overview-name")
                .textContent
                .trim()
                .toLowerCase();

            const beschrijving = row.children[1]
                .textContent
                .trim()
                .toLowerCase();

            const ean = row.children[3]
                .textContent
                .trim()
                .toLowerCase();

            const categorieIds = row.dataset.categorieen.split("|");
            const isActief = row.dataset.actief;

            const matchesSearch =
                artikelNaam.includes(searchValue) ||
                beschrijving.includes(searchValue) ||
                ean.includes(searchValue);

            const matchesCategorie =
                selectedCategorieId === "" ||
                categorieIds.includes(selectedCategorieId);

            const matchesStatus =
                selectedArtikelStatus === "" ||
                isActief === selectedArtikelStatus;

            row.style.display =
                matchesSearch &&
                matchesCategorie &&
                matchesStatus
                    ? ""
                    : "none";
        });
    }

    searchbar.addEventListener("input", filterRows);

    categorieDropdown.addEventListener("change", function () {
        searchbar.value = "";
        filterRows();
    });

    artikelStatusDropdown.addEventListener("change", function () {
        searchbar.value = "";
        filterRows();
    });
</script>

<script>
    document.querySelectorAll(".status-btn").forEach(button => {

        button.addEventListener("click", async function () {

            if (this.dataset.actief !== "true") {
                return;
            }

            if (!confirm("Wil je dit artikel inactief zetten?")) {
                return;
            }

            const id = this.dataset.id;

            const response = await fetch(`/Artikel/Deactivate?id=${id}`, {
                method: "POST"
            });

            if (response.ok) {
                location.reload();
            } else {
                alert("Er is iets fout gegaan.");
            }
        });

    });
</script>