@model ArtikelToevoegenViewModel

@{
    ViewData["Title"] = "Artikel Toevoegen";
}

<div class="modal fade" id="addArtikelModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">
                    Artikel toevoegen
                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal">
                </button>
            </div>

            <div class="modal-body">

                @await Html.PartialAsync("_AddArtikelForm", Model)
                
            </div>

        </div>
    </div>
</div>