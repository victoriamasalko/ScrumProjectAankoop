@model Web.Models.ViewModels.LeverancierOverviewViewModel
@{
	ViewData["Title"] = "Leveranciers";
}
<h2>Adresboek van Leveranciers</h2>
<table>
	<thead>
		<tr>
			<th>Leverancier</th>
			<th>Contactpersoon</th>
			<th>Artikelen</th>
			<th></th>
		</tr>
	</thead>
	<tbody>
		@foreach (var leverancier in Model.Leveranciers)
		{
			<tr>
				<td>@leverancier.Naam</td>
				<td>@leverancier.VoornaamContactpersoon @leverancier.FamilienaamContactpersoon</td>
				<td>
					@foreach(var artikel in leverancier.Artikels)
					{
						<span>@artikel.Naam</span>
					}
				</td>
				<td><a asp-action="Details">Details</a></td>
			</tr>
		}
	</tbody>
</table>
