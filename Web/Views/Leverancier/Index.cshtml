@model Web.Models.ViewModels.LeverancierOverviewViewModel
@{
	ViewData["Title"] = "Leveranciers";
}
<h2>Adresboek van Leveranciers</h2>
<table>
	<thead>
		<tr>
			<th>Leverancier</th>
			<th>Btw-nummer</th>
			<th>Contactpersoon</th>
			<th>Artikelen</th>
			<th></th>
		</tr>
	</thead>
	<tbody>
		@foreach (var leverancier in Model.Leveranciers)
		{
			<tr>
				<td>@leverancier.Naam</td>
				<td>@leverancier.BtwNummer</td>
				<td>@leverancier.VoornaamContactpersoon @leverancier.FamilienaamContactpersoon</td>
				<td>
					@if(leverancier.Artikels != null && leverancier.Artikels.Any())
					{
						@foreach (var artikelNaam in leverancier.Artikels.Select(a=>a.Naam).Distinct())
							{
								<span>@artikelNaam</span>
							}
					}
					
				</td>
				<td><a asp-action="Details" asp-route-id="@leverancier.LeveranciersId">Details</a></td>
			</tr>
		}
	</tbody>
</table>


