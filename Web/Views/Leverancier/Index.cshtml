@model Web.Models.ViewModels.LeverancierOverviewViewModel
@{
	ViewData["Title"] = "Leveranciers";
}

<section class="supplier-page">
	<header class="supplier-header">
		<h1 class="supplier-title">
			Adresboek van <em>leveranciers</em>
		</h1>

		<button class="btn btn-primary supplier-create-button" type="button">
			<span aria-hidden="true">+</span>
			Nieuwe leverancier
		</button>
	</header>

	<div class="supplier-toolbar row gx-3 align-items-end">
		<div class="col-12 col-md-4">
			<label class="visually-hidden" for="supplier-category">Categorie</label>
			<select class="form-select supplier-control" id="supplier-category">
				<option selected>Alle categorieën</option>
			</select>
		</div>
		<div class="col-12 col-md-4">
			<label class="visually-hidden" for="supplier-status">Status</label>
			<select class="form-select supplier-control" id="supplier-status">
				<option selected>Alle statussen</option>
			</select>
		</div>
		<div class="col-12 col-md-4">
			<label class="visually-hidden" for="supplier-search">Zoeken</label>
			<input class="form-control supplier-control" id="supplier-search" type="search" placeholder="Zoeken op naam of EAN..." />
		</div>
	</div>

	<div class="table-responsive supplier-table-wrapper">
		<table class="table supplier-table align-middle mb-0">
			<thead>
				<tr>
					<th scope="col">Leverancier</th>
					<th scope="col">Btw-nummer</th>
					<th scope="col">Contactpersoon</th>
					<th scope="col"><span class="visually-hidden">Acties</span></th>
				</tr>
			</thead>
			<tbody>
				@foreach (var leverancier in Model.Leveranciers)
				{
					<tr>
						<td data-label="Leverancier" class="supplier-name">@leverancier.Naam</td>
						<td data-label="Btw-nummer">@leverancier.BtwNummer</td>
						<td data-label="Contactpersoon">@leverancier.VoornaamContactpersoon @leverancier.FamilienaamContactpersoon</td>
						<td data-label="Acties" class="supplier-actions">
							<a class="btn btn-tertiary supplier-details-button" asp-action="Details" asp-route-id="@leverancier.LeveranciersId">Details</a>
						</td>
					</tr>
				}
			</tbody>
		</table>
	</div>
</section>
