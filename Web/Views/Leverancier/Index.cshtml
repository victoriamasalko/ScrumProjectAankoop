@model IEnumerable<LeverancierOverviewViewModel>
@{
    ViewData["Title"] = "Leveranciers";
}

<section class="overview-page">
    <header class="overview-header">
        <h1 class="overview-title">
            Adresboek van <em>leveranciers</em>
        </h1>


		<button id="openAddLeverancierBtn" class="btn btn-primary overview-create-button" type="button">
			<span aria-hidden="true">+</span>
			Nieuwe leverancier
		</button>

	</header>

    <div class="overview-toolbar row gx-3 align-items-end">
        <div class="col-12 col-md-4">
            <label class="visually-hidden" for="overview-category">Categorie</label>
            <select class="form-select overview-control" id="overview-category">
                <option selected>Alle categorieën</option>
            </select>
        </div>
        <div class="col-12 col-md-4">
            <label class="visually-hidden" for="overview-status">Status</label>
            <select class="form-select overview-control" id="overview-status">
                <option selected>Alle statussen</option>
            </select>
        </div>
        <div class="col-12 col-md-4">
            <label class="visually-hidden" for="overview-search">Zoeken</label>
            <input class="form-control overview-control" id="overview-search" type="search" placeholder="Zoeken op naam of EAN..." />
        </div>
    </div>

	
    <div class="table-responsive overview-table-wrapper">
        <table class="table overview-table align-middle mb-0">
            <thead>
                <tr>
                    <th scope="col">Leverancier</th>
                    <th scope="col">Btw-nummer</th>
                    <th scope="col">Contactpersoon</th>
                    <th scope="col"><span class="visually-hidden">Acties</span></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var leverancier in Model)
                {
                    <tr>
                        <td data-label="Leverancier" class="overview-name">@leverancier.Naam</td>
                        <td data-label="Btw-nummer">@leverancier.BtwNummer</td>
                        <td data-label="Contactpersoon">@leverancier.VoornaamContactpersoon @leverancier.FamilienaamContactpersoon</td>
                        <td data-label="Acties" class="overview-actions">
                            <a class="btn btn-tertiary overview-details-button" asp-action="Details" data-id="@leverancier.LeveranciersId" asp-route-id="@leverancier.LeveranciersId">Details</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div id="modalContainer"></div>
</section>


<script>
    // Haal de searchbar op via zijn ID
        const searchbar = document.getElementById('overview-search');
        //Geef de searchbar een input listener 
        searchbar.addEventListener('input', function () {
            const searchValue = searchbar.value.trim().toLowerCase();
            //Selecter alle rows 
            const rows = document.querySelectorAll('.overview-table tbody tr');
            // de naam en btwnummer selecteren voor elke leverancier
            rows.forEach(row => {
                const leverancierNaam = row.querySelector('.overview-name')
                    .textContent
                    .trim()
                    .toLowerCase();

                const btwNummer = row.children[1]
                    .textContent
                    .trim()
                    .toLowerCase();
                    // als de searchvalue langer is dan 3 characters en leveranciernaam of btwnummer begint met deze 3 letters toon dan de list item anders zet je de display value op none
                if (
               
                    leverancierNaam.startsWith(searchValue) ||
                    btwNummer.startsWith(searchValue)
                ) {
                    row.style.display = '';
                } else {
                    row.style.display = 'none';
                }
            });
        });

		
        
    
</script>


<script>

	document.querySelectorAll('.overview-details-button')
		.forEach(button => {

			button.addEventListener('click', function (e) {

				e.preventDefault();

				const id = this.dataset.id;

				fetch(`/Leverancier/Details?id=${id}`)
					.then(r => r.text())
					.then(html => {

						document.getElementById('modalContainer').innerHTML = html;

						bootstrap.Modal
							.getOrCreateInstance(
								document.getElementById('detailsModal')
							)
							.show();

					});
			});
		});



</script>

	
<script>

	// listeners voor de item list in details, dit moet hier omdat script niet geladen worden in partial views enkel en volledige views.
	document.addEventListener('click', function (e) {

		const list = e.target.closest('.list');

		if (!list)
			return;

		const pages = list.querySelectorAll('.list__items');
		const indicator = list.querySelector('.list__page-indicator');

	let currentPage =
		[...pages].findIndex(p => p.classList.contains('active'));

	if (currentPage === -1)
		currentPage = 0;

		const pageCount =
			parseInt(list.dataset.pageCount);

		if (e.target.classList.contains('list__next')) {

			if (currentPage < pageCount - 1) {

				pages[currentPage].classList.remove('active');

				currentPage++;

				pages[currentPage].classList.add('active');

				indicator.textContent =
					`${currentPage + 1} / ${pageCount}`;
			}
		}

		if (e.target.classList.contains('list__prev')) {

			if (currentPage > 0) {

				pages[currentPage].classList.remove('active');

				currentPage--;

				pages[currentPage].classList.add('active');

				indicator.textContent =
					`${currentPage + 1} / ${pageCount}`;
			}
		}
	});
</script>


	<script>

		function wireAddLeverancierEvents() {

			document.getElementById('saveLeverancierBtn')
				.addEventListener('click', function () {

					const formData = new FormData();
					formData.append('Naam', document.querySelector('[name="naam"]').value);
					formData.append('BtwNummer', document.querySelector('[name="btw"]').value);
					formData.append('Straat', document.querySelector('[name="straat"]').value);
					formData.append('HuisNummer', document.querySelector('[name="huisnummer"]').value);
					formData.append('Bus', document.querySelector('[name="bus"]').value);
					formData.append('PlaatsId', document.querySelector('[name="PlaatsId"]').value);
					formData.append('FamilienaamContactperoon', document.querySelector('[name="familienaam"]').value);
					formData.append('VoornaamContactpersoon', document.querySelector('[name="voornaam"]').value);

					fetch('/Leverancier/AddLeverancierAsync', {
						method: 'POST',
						body: formData
					})
						.then(r => {
							if (r.redirected) {
								window.location.href = r.url;
							}
						});
				});
		}

		document.getElementById('openAddLeverancierBtn').addEventListener('click', function () {
				fetch('/Leverancier/AddLeverancier')
					.then(r => r.text())
					.then(html => {

						document.getElementById('modalContainer').innerHTML = html;

						bootstrap.Modal
							.getOrCreateInstance(
								document.getElementById('addLeverancierModal')
							)
							.show();

						wireAddLeverancierEvents();
					});
			});

	</script>

