@model EditLeverancierViewModel
@{
    ViewData["Title"] = "Leverancier Details";
}

<h1>EDIT!!!</h1>

@if (Model is not null)
{
    <form asp-action="SaveChanges" method="post">

        <input type="hidden" asp-for="@Model.LeverancierId"/>
        
        <label asp-for="Naam"></label>
        <span asp-validation-for="Naam"></span>
        <input asp-for="Naam"/>
        
        <label asp-for="BtwNummer"></label>
        <span asp-validation-for="BtwNummer"></span>
        <input asp-for="BtwNummer"/>
        
        <label asp-for="Straat"></label>
        <span asp-validation-for="Straat"></span>
        <input asp-for="Straat"/>
        
        <label asp-for="HuisNummer"></label>
        <span asp-validation-for="HuisNummer"></span>
        <input asp-for="HuisNummer"/>
        
        <label asp-for="Bus"></label>
        <span asp-validation-for="Bus"></span>
        <input asp-for="Bus"/>
        
        <label asp-for="Plaats"></label>
        <select name="PlaatsId">
            @foreach (var plaats in Model.Plaats)
            {
                <option value="@plaats.Value">@plaats.Text</option>
            }
        </select>
        
        <label asp-for="FamilienaamContactperoon"></label>
        <span asp-validation-for="FamilienaamContactperoon"></span>
        <input asp-for="FamilienaamContactperoon"/>
        
        <label asp-for="VoornaamContactpersoon"></label>
        <span asp-validation-for="VoornaamContactpersoon"></span>
        <input asp-for="VoornaamContactpersoon"/>

        <div asp-validation-summary="All"></div>
        <input type="submit" value="Save changes" class="btn btn-primary"/>

    </form>
}
else
{
<p>Leverancier niet gevonden.</p>
}