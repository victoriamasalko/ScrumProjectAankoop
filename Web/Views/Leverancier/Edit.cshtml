@model EditLeverancierViewModel
@{
    ViewData["Title"] = "Leverancier Editeren";
}
<div class="modal fade" id="editLeverancierModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">
                    Leverancier aanpassen
                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal">
                </button>
            </div>

            <div class="modal-body">
            @await Html.PartialAsync("_EditLeverancierForm", Model)
            </div>

        </div>
    </div>
</div>