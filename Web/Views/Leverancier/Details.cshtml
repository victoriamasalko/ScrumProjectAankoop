@model Leverancier
@{
    ViewData["Title"] = "Leverancier Details";
}

@if (Model is not null)
{
    <div class="modal fade" id="detailsModal"
         tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">

                <div class="modal-header">
                    <h5 class="modal-title">
                        @Model.Naam
                    </h5>

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal">
                    </button>
                </div>

                <div class="modal-body">
                    <h6 class="detail-subtitle">Leverancier</h6>
                    <p>
                        <strong>BTW-nummer:</strong>
                        <span>@Model.BtwNummer</span>
                    </p>
                    <p>
                        <strong>Straat:</strong>
                        <span>@Model.Straat</span>
                    </p>
                    <p>
                        <strong>Huis Nr.:</strong>
                        <span>@Model.HuisNummer</span>
                    </p>
                    <p>
                        <strong>Bus:</strong>
                        <span>@Model.Bus</span>
                    </p>
                    <p>
                        <strong>Postcode:</strong>
                        <span>@Model.Plaats.Postcode</span>
                    </p>
                    <p>
                        <strong>Plaats:</strong>
                        <span>@Model.Plaats.Naam</span>
                    </p>
                    <h6 class="detail-subtitle">Contactpersoon</h6>
                    <p>
                        <strong>Familienaam:</strong>
                        <span>@Model.FamilienaamContactpersoon</span>
                    </p>
                    <p>
                        <strong>Voornaam:</strong>
                        <span>@Model.VoornaamContactpersoon</span>
                    </p>
                    <h6 class="detail-subtitle">Artikels</h6>
                    @* @foreach (var artikel in Model.Artikels.OrderBy(a => a.Naam))
                    {
                        <span>@artikel.Naam</span>
                    } *@
                    @await Component.InvokeAsync(
                        "List",
                        Model.Artikels.OrderBy(a => a.Naam).Cast<object>()
                    )                    
                    <button class="btn btn-primary"
                            id="openCreateBtn"
                            data-product-id="@Model.LeveranciersId">
                        wijzigen
                    </button>

                </div>

            </div>
        </div>
    </div>
}
