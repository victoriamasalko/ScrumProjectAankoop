@model IEnumerable<CategorieOverviewViewModel>

@foreach (var categorie in Model)
{
    @if (categorie.Subcategorieen.Any())
    {
        <option value="@categorie.CategorieId">@(String.Concat(new String('*', categorie.Level),@categorie.Naam))</option>

        

        <partial name="PartialAdd" model="categorie.Subcategorieen" />
    }
    else
    {
        <option value="@categorie.CategorieId">@(String.Concat(new String('*', categorie.Level),@categorie.Naam))</option>
    }
}