@model IEnumerable<CategorieOverviewViewModel>

<h1>De <em>categorieboom</em></h1>

<div>
	<table class="table">
		<thead>
			<tr>
				<th class="p-2">Categorie</th>
				<th class="p-2">Hoofdcategorie</th>
			</tr>
		</thead>
		<tbody>
			@foreach (var categorie in Model)
			{
				<tr>
					<td class="p-2" data-label="Categorie">@categorie.Naam</td>
					<td class="p-2" data-label="Hoofdcategorie">@categorie.HoofdCategorieNaam</td>
				</tr>
			}
		</tbody>
	</table>
</div>

@if (Model.Count() == 0)
{
	<div>Er zijn nog geen artikelen.</div>
}