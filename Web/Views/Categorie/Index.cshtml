@model IEnumerable<CategorieOverviewViewModel>

<section class="overview-page">
    
    <header class="overview-header">
        <h1 class="overview-title">
            De <em>categorieboom</em>
        </h1>


        <button type="button"
                class="btn btn-secondary overview-create-button"
                onclick="location.href='@Url.Action("AddCategorie", "Categorie")'">
            <span aria-hidden="true">+</span>
            Nieuwe Categorie
        </button>


    </header>
    <main>

    <div class="category-tree">
        @foreach (var categorie in Model)
        {
            @if (categorie.Subcategorieen.Any())
            {
                <p class="category-tree__item cat-@(categorie.Level + 1)">@categorie.Naam</p>
                <partial name="PartialSubcategorieen" model="categorie.Subcategorieen"/>
            }
            else
            {
                <p class="category-tree__item cat-@(categorie.Level + 1)">
                    <span>@categorie.Naam</span>
                </p>
            }
        }
    </div>
    
    </main>

</section>
