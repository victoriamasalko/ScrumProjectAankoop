@model IEnumerable<CategorieOverviewViewModel>

<h1>De <em>categorieboom</em></h1>

<div>
	@foreach (var categorie in Model)
	{
		<p>@categorie.Naam</p>
		@if (categorie.Subcategorieen.Any())
		{
			<partial name="PartialSubcategorieen" model="(categorie.Subcategorieen, Niveau:1)"/>
		}
	}
</div>

@if (Model.Count() == 0)
{
	<div>Er zijn nog geen artikelen.</div>
}

