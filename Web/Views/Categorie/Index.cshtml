@model IEnumerable<CategorieOverviewViewModel>

<section class="overview-page">
    
    <header class="overview-header">
        <h1 class="overview-title">
            De <em>categorieboom</em>
        </h1>


        <button type="button"
                id="overview-add-button"
                class="btn btn-primary overview-create-button">
            <span aria-hidden="true">+</span>
            Nieuwe Categorie
        </button>


    </header>
    <main>
        <div class="category-tree">
            <partial name="PartialSubcategorieen" model="Model" />
        </div>
    
    </main>

    <div id="modalContainer">
        
    </div>
</section>

<script>
    
    
    const addButton = document.getElementById('overview-add-button')

            addButton.addEventListener('click', function (e) {
                e.preventDefault();

                fetch(`/Categorie/AddCategorie`)
                    .then(r => r.text())
                    .then(html => {

                        document.getElementById('modalContainer').innerHTML = html;

                        bootstrap.Modal
                            .getOrCreateInstance(
                                document.getElementById('addCategorieModal')
                            )
                            .show();

                    });
            });
</script>