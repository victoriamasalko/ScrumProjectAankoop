@model AddCategorieViewModel

<form asp-action="AddCategorie" method="post">

	<label asp-for="NieuweNaam" class="form-label">Naam</label>
	<input asp-for ="NieuweNaam" class="form-control" />
	<span asp-validation-for="NieuweNaam" class="text-danger"></span>

    <label asp-for="SelectedCategorieId" class="form-label">Categorie</label>
    <select asp-for="SelectedCategorieId" class="form-control">
        @*Dropdown; voor elke categorie check je of er een subcategorie is. 
          Dan spring je in gelijk aan het level van de categorie.
          Vervolgens roep je een PartialView op die hetzelfde zal doen.*@
        @foreach (var categorie in Model.Subcategorieen)
        {
            @if (categorie.Subcategorieen.Any())
            {
                <option value="@categorie.CategorieId">
                    @(string.Concat(Enumerable.Repeat("\u00A0\u00A0\u00A0\u00A0", categorie.Level)) + categorie.Naam)
                </option>

        

                <partial name="PartialAdd" model="categorie.Subcategorieen" />
            }
            else
            {
                <option value="@categorie.CategorieId">
                    @(string.Concat(Enumerable.Repeat("\u00A0\u00A0\u00A0\u00A0", categorie.Level)) + categorie.Naam)
                </option>
            }
        }
    </select>

	<button type="submit" class="btn btn-primary">Toevoegen</button>
	<a asp-action="Index" class="btn btn-warning">Annuleren</a>
    
</form>



