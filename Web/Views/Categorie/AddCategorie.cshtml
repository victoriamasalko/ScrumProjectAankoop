@model AddCategorieViewModel


<div class="modal fade" id="addCategorieModal"
     tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">
                    Categorie <em>aanmaken</em>
                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal">
                </button>
            </div>
            <div class="modal-body">
                
                @await Html.PartialAsync("_AddCategorieForm", Model)

            </div>
        </div>
    </div>          
</div>





