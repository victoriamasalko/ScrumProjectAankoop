@model AddCategorieViewModel

<form asp-action="AddCategorie" method="post">

	<label asp-for="Naam">Naam</label>
	<input asp-for ="Naam" class="form-control" />
	<span asp-validation-for="Naam" class="text-danger"></span>

	<label asp-for="HoofdCategorieId">Hoofdcategorie</label>
	<select asp-for="HoofdCategorieId"
			asp-items="Model.BeschikbareCategorieen"
			class="form-select">
	</select>

	<button type="submit" class="btn btn-primary">Toevoegen</button>
	<a asp-action="Index" class="btn btn-warning">Annuleren</a>

</form>


