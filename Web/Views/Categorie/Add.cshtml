@model AddCategorieViewModel

<form>
    <label asp-for="Naam" class="form-label"></label>
    <input asp-for="Naam" class="form-control" />
    <span asp-validation-for="Naam" class="text-danger"></span>

    <select>
        @foreach (var categorie in Model.Subcategorieen)
        {
            @if (categorie.Subcategorieen.Any())
            {
                <option value="@categorie.CategorieId">@(String.Concat(new String('*', categorie.Level),@categorie.Naam))</option>

        

                <partial name="PartialAdd" model="categorie.Subcategorieen" />
            }
            else
            {
                <option value="@categorie.CategorieId">@(String.Concat(new String('*', categorie.Level),@categorie.Naam))</option>
            }
        }
    </select>
</form>



