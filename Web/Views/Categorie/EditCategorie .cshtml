@model AddCategorieViewModel

<form asp-action="EditCategorie" method="post">

	<label asp-for="NieuweNaam" class="form-label">Naam</label>
	<input asp-for ="NieuweNaam" class="form-control" />
	<span asp-validation-for="NieuweNaam" class="text-danger"></span>

	 <partial name="PartialSelectListCategories" model="Model" />

	<button type="submit" class="btn btn-primary">Toevoegen</button>
	<a asp-action="Index" class="btn btn-warning">Annuleren</a>
    
</form>



