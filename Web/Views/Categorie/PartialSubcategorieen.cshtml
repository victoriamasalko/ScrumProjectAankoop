@model (IEnumerable<CategorieOverviewViewModel> Subcategorieen, int Niveau)

@foreach (var categorie in Model.Subcategorieen)
{
    <div style="padding-left: @(Model.Niveau * 25)px;">
    @if (categorie.Subcategorieen.Any())
    {        
        <p>@categorie.Naam</p>
        @if (categorie.Subcategorieen.Any())
        {
            <partial name="PartialSubcategorieen" model="(categorie.Subcategorieen, Model.Niveau + 1)" />
        }
    }
    else
    {
        <p><span>@categorie.Naam</span></p>
    }
    </div>    
}
