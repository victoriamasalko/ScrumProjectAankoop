@model List<Actiecode>
@{
    ViewData["Title"] = "Actiecodes";
}

<header class="overview-header">
    <h1 class="overview-title">
        Actiecodes
    </h1>

    <button class="btn btn-primary add-button" type="button">
        <a asp-action="Toevoegen" asp-controller="Actiecode">
            <span aria-hidden="true">+</span>
            Nieuwe actiecode
        </a>
    </button>

</header>

@* Deze filters werken nog niet (kopie van leveranciers)
<br/>

<div class="overview-toolbar row gx-3 align-items-end">
    <div class="col-12 col-md-4">
        <label class="visually-hidden" for="overview-category">Categorie</label>
        <select class="form-select overview-control" id="overview-category">
            <option selected>Alle xxx</option>
        </select>
    </div>
    <div class="col-12 col-md-4">
        <label class="visually-hidden" for="overview-status">Status</label>
        <select class="form-select overview-control" id="overview-status">
            <option selected>Alle xxx</option>
        </select>
    </div>
    <div class="col-12 col-md-4">
        <label class="visually-hidden" for="overview-search">Zoeken</label>
        <input class="form-control overview-control" id="overview-search" type="search" placeholder="Zoeken op xxx"/>
    </div>
</div> *@

<div class="table-responsive overview-table-wrapper">
    <table class="table overview-table align-middle mb-0">
        <thead>
        <tr>
            <th class="p-2">Naam</th>
            <th class="p-2">Geldig van</th>
            <th class="p-2">Geldig tot</th>
            <th class="p-2">Eenmalig?</th>
            <th class="p-2">Status</th>
            <th class="p-2"></th>
        </tr>
        </thead>
        <tbody>
        @foreach (var actiecode in Model)
        {
            <tr>
                <td class="p-2" data-label="Naam">@actiecode.Naam</td>
                <td class="p-2" data-label="GeldigVan">@actiecode.GeldigVanDatum</td>
                <td class="p-2" data-label="GeldigTot">@actiecode.GeldigTotDatum</td>
                <td class="p-2" data-label="Eenmalig">@((actiecode.IsEenmalig) ? "✓" : "X")</td> @* Toont of de actiecode eenmalig gebruikt kan worden *@
                <td class="p-2">@((actiecode.GeldigVanDatum <= DateTime.Today && DateTime.Today <= actiecode.GeldigTotDatum) ? "Actief" : "Niet actief")</td> @* Toont of de actiecode momenteel actief is *@
                <td class="p-2">
                    @if (actiecode.GeldigVanDatum < DateTime.Today && actiecode.GeldigTotDatum < DateTime.Today)
                    {
                        <a class="btn btn-tertiary edit-button disabled"
                           aria-disabled="true"
                           tabindex="1"
                           asp-action="ActiecodeWijzigen"
                           asp-route-id="@actiecode.ActiecodeId"
                           data-id="@actiecode.ActiecodeId">Wijzigen</a>
                    }
                    else
                    {
                        <a class="btn btn-tertiary edit-button"
                           asp-action="ActiecodeWijzigen"
                           asp-route-id="@actiecode.ActiecodeId"
                           data-id="@actiecode.ActiecodeId">Wijzigen</a>
                    }
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>

<div id="modalContainer"></div>


<script>

    document.querySelectorAll('.edit-button')
        .forEach(button => {
            button.addEventListener('click', function (e) {
                e.preventDefault();
                const id = this.dataset.id;
                fetch(`/Actiecode/ActiecodeWijzigen?id=${id}`)
                    .then(r => r.text())
                    .then(html => {
                        document.getElementById('modalContainer').innerHTML = html;
                        bootstrap.Modal
                            .getOrCreateInstance(
                                document.getElementById('actieCodeEdit')
                            )
                            .show();
                        wireEditActiecodeEvents();
                    });
            });
        });

    document.querySelectorAll('.add-button')
        .forEach(button => {
            button.addEventListener('click', function (e) {
                e.preventDefault();
                const id = this.dataset.id;
                fetch(`/Actiecode/Toevoegen`)
                    .then(r => r.text())
                    .then(html => {
                        document.getElementById('modalContainer').innerHTML = html;
                        bootstrap.Modal
                            .getOrCreateInstance(
                                document.getElementById('actieCodeAdd')
                            )
                            .show();
                        wireAddActiecodeEvents();
                    });
            });
        });

    function wireAddActiecodeEvents() {

        const form = document.getElementById("addActiecodeForm");

        form.addEventListener("submit", async function (e) {

            e.preventDefault();

            const response = await fetch(form.action, {
                method: form.method,
                body: new FormData(form)
            });

            if (response.redirected) {
                window.location.href = response.url;
                return;
            }

            const html = await response.text();

            document.getElementById("addActiecodeForm").outerHTML = html;

            // The form has been replaced, so wire it up again
            wireAddActiecodeEvents();
        });
    }

    function wireEditActiecodeEvents() {

        const form = document.getElementById("editActiecodeForm");

        form.addEventListener("submit", async function (e) {

            e.preventDefault();

            const response = await fetch(form.action, {
                method: form.method,
                body: new FormData(form)
            });

            if (response.redirected) {
                window.location.href = response.url;
                return;
            }

            const html = await response.text();

            document.getElementById("editActiecodeForm").outerHTML = html;

            // The form has been replaced, so wire it up again
            wireEditActiecodeEvents();
        });
    }
</script>