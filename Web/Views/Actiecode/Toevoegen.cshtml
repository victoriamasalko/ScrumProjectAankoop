@model ActiecodeToevoegenViewModel

@{
    ViewData["Title"] = "Actiecode Toevoegen";
}

<div class="modal fade" id="actieCodeAdd"
     tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title">
                    Actiecode <em>toevoegen</em>
                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal">
                </button>
            </div>

            <div class="modal-body">
                
                @await Html.PartialAsync("_AddActiecodeForm", Model)
                
            </div>
        </div>
    </div>
</div>