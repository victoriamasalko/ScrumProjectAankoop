@model ActiecodeWijzigenViewModel

@{
    ViewData["Title"] = "Actiecode Wijzigen";
}

<div class="modal fade" id="actieCodeEdit"
     tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title">
                    Actiecode <em>wijzigen</em>
                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal">
                </button>
            </div>

            <div class="modal-body">

                @await Html.PartialAsync("_EditActiecodeForm", Model)

            </div>
        </div>
    </div>
</div>